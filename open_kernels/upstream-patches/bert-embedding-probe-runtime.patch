+  npue::Encoded encode_token_ids(const std::vector<int32_t> &ids, size_t index,
+                                  int64_t sequence) const {
+    if (ids.size() > static_cast<size_t>(sequence))
+      throw npue::InputTooLong(index, ids.size(), sequence);
+    const auto vocab = vocab_size();
+    if (ids.empty() || std::any_of(ids.begin(), ids.end(), [vocab](int32_t id) {
+          return id < 0 || static_cast<size_t>(id) >= vocab;
+        }))
+      throw std::invalid_argument("input " + std::to_string(index) +
+                                  " must contain valid model token IDs");
+    const auto pad = wordpiece ? wordpiece->pad_id : xlmr->pad_id;
+    npue::Encoded encoded;
+    encoded.n_tokens = encoded.n_tokens_full = static_cast<int32_t>(ids.size());
+    encoded.input_ids = ids;
+    encoded.input_ids.resize(sequence, pad);
+    encoded.attention_mask.assign(ids.size(), 1);
+    encoded.attention_mask.resize(sequence, 0);
+    encoded.token_type_ids.assign(sequence, 0);
+    return encoded;
   }

