# C++ build
**/*.obj
**/*.exe
**/*.lib
**/*.exp
**/*.dll
**/*.pdb

# Python
__pycache__/
*.pyc

# Model weights, NPU pools, captured buffers, scratch data (never commit)
*.q4nx
*.gguf
*.bin
*.npy
*.npz
*.f32
*.i64
*.safetensors
m3out/
caps/

# Small golden fixtures that ARE committed
!specs/viz/tests/fixtures/mlir/lx0/insts.bin

# open_kernels build output, run configs and logs
/open_kernels/.staging*/
/open_kernels/designs/.locks/
open_kernels/designs/*/build*/
open_kernels/designs/*/out*.bin
open_kernels/designs/*/in.bin
open_kernels/designs/*/run*.cfg
open_kernels/designs/*/big.bin
/src/open_qwen36/out/
open_kernels/designs/*/*.log
# Generated kernel TUs: written per spec by the exports, never source
# (specs/open-engine/tests/test_generated_tus_untracked.py)
open_kernels/designs/dense/*.cc
open_kernels/designs/layer_x/*.cc
open_kernels/designs/layer_x/xh_signs.h
open_kernels/designs/lm_head_q4/*.cc
# Generated gemv_q4 entry points: one .cc per (per_call, per_band, rs, k-tile)
# written by gemv_q4._mksrc during export. A new spec's geometry produces a new
# p*b*r* family (p1b108r2, p25b100r2, ...) that must never be swept up by
# `git add .`. The p4b* baselines and the two prep *_rt.cc helpers are checked-in
# sources and are re-included below (tracked files are unaffected by ignore anyway).
open_kernels/designs/gemv_q4/gemv_q4_p*b*r*_k*.cc
open_kernels/designs/gemv_q4/gemv_q4s32_p*b*r*_k*.cc
!open_kernels/designs/gemv_q4/gemv_q4_p4b*_k*.cc
!open_kernels/designs/gemv_q4/gemv_q4s32_p4b*_k*.cc
open_kernels/designs/gemv_q4/gemv_q4_prep_k*.cc
open_kernels/designs/gemv_q4/gemv_q4_p*b*r*_k*.cc
open_kernels/designs/gemv_q4/gemv_q4s32_*.cc
open_kernels/designs/gemv_q4/*prep_blk_k*.cc
open_kernels/designs/gemv_t2/*.cc
open_kernels/model/out*/
open_kernels/harness/out/

# Editor / tooling / index artifacts
.claude/
.codegraph/
.DS_Store
/.plans/
