+#ifdef PHLEGM_INKLING2
+class Inkling2Session {
+public:
+    Inkling2Session(const CoreConfig& config, const std::string& route, const json& manifest)
+        : capacity_(config.max_ctx), chunk_(block_size(route, config.prefill_mode)),
+          model_((std::filesystem::path(config.model_dir) / "model.gguf").string(), capacity_,
+                 open_qwen36::make_inkling2_npu_experts(config.kernel_dir, config.timeout_ms)) {
+#ifdef PHLEGM_INKLING2_VISION
+        const auto mmproj = std::filesystem::path(config.model_dir) / "mmproj.gguf";
+        const auto abi = manifest.value("abi", std::string{});
+        if ((abi == "inkling2-routed-v9" || abi == "inkling2-routed-v10" || abi == "inkling2-routed-v11") &&
+            std::filesystem::is_regular_file(mmproj)) {
+            mmproj_ = mmproj.string();
+            kernel_dir_ = config.kernel_dir;
+            timeout_ms_ = config.timeout_ms;
+        }
+#endif
+#ifdef PHLEGM_INKLING2_DSPARK
+        const auto draft = std::filesystem::path(config.model_dir) / "dspark.gguf";
+        if (can_verify() && std::filesystem::is_regular_file(draft)) draft_path_ = draft.string();
+#endif
+    }
+
+    void ready(const std::string& device) const {
+        json info = {{"device", device}, {"context_capacity", capacity_}, {"real_vocab", vocab},
+                     {"layers", open_qwen36::Inkling2Host::layer_count}, {"weights_file", "model.gguf"},
+                     {"prefill_chunk", chunk_}, {"prefill_route", chunk_ == 1 ? "sequential" : "layer-major"},
+                     {"prefill_device", chunk_ == 1 || model_.block_experts_available() ? "mixed" : "host"}};
+#ifdef PHLEGM_INKLING2_VISION
+        if (!mmproj_.empty()) info["image_placeholder"] = 200054;
+#endif
+        if (can_verify()) info["verify_width"] = draft_path_.empty() ? lookup_width : draft_width;
+        if (!draft_path_.empty()) info["draft"] = {{"method", "dspark"}, {"max", draft_width - 1}};
+        // Below 16 rows a block-route pass costs more than the decode tokens it can save.
+        if (can_verify() && draft_path_.empty()) info["long_verify"] = {{"max_rows", wide_width}, {"min_rows", 16}};
+        reply(std::move(info));
+    }
+
+    void request(const std::string& command, const json& req) {
+        if (command == "reset") {
+            reset(req.value("dspark", false));
+            reply({});
+#ifdef PHLEGM_INKLING2_VISION
+        } else if (command == "encode_image") {
+            encode_image(req);
+        } else if (command == "prefill_image_chunk") {
+            prefill_image(req);
+#endif
+        } else if (command == "verify_logits") {
+            if (!can_verify() || req.value("accept", 0) != 0)
+                throw std::runtime_error("unsupported Inkling 2 verify request");
+            auto tokens = req.at("tokens").get<std::vector<int>>();
+            const auto draft_count = req.value("draft", size_t{0});
+            if (tokens.empty() || tokens.size() > (capture() ? draft_width : wide_width))
+                throw std::runtime_error("invalid verify width");
+            if (draft_count) {
+#ifdef PHLEGM_INKLING2_DSPARK
+                if (!draft_ || tokens.size() != 1 || draft_->position() != model_.position())
+                    throw std::runtime_error("DSpark requires an aligned prefix and one anchor");
+                const auto proposals = draft_->propose(tokens.front(), draft_count);
+                tokens.insert(tokens.end(), proposals.begin(), proposals.end());
+#else
+                throw std::runtime_error("this bridge was built without DSpark");
+#endif
+            }
+            const auto logits = model_.verify(tokens, capture());
+            reply_logits({{"position", model_.position()}, {"rows", tokens.size()}, {"tokens", tokens}},
+                         logits, tokens.size() * vocab);
+        } else if (command == "accept") {
+            const auto accepted = req.at("n").get<size_t>();
+            model_.accept(accepted);
+            append_draft(accepted);
+            reply({{"position", model_.position()}});
+        } else if (command == "prefill_chunk") {
+            const auto ids = req.at("prompt").get<std::vector<int>>();
+            if (ids.empty() || ids.size() > chunk_) throw std::runtime_error("invalid Inkling 2 prefill chunk");
+            append(ids, false);
+            reply({{"position", model_.position()}});
+        } else if (command == "prefill" || command == "prefill_logits") {
+            respond(prefill(req.at("prompt").get<std::vector<int>>()), command == "prefill_logits");
+        } else if (command == "decode" || command == "decode_logits") {
+            respond(append({req.at("token").get<int>()}, true), command == "decode_logits");
+        } else if (command == "trial" || command == "survey_trial") {
+            const auto ids = req.at("prompt").get<std::vector<int>>();
+            reset(false);
+            trial(req, ids, command == "survey_trial", capacity_, vocab,
+                  [&] { return greedy(prefill(ids), vocab); },
+                  [&](int token) { return greedy(model_.append({token}), vocab); });
+        } else {
+            throw std::runtime_error("unsupported Inkling 2 command");
+        }
+    }
+
+private:
+    static constexpr size_t vocab = open_qwen36::Inkling2Host::vocabulary_size;
+    static constexpr size_t lookup_width = 4;
+    static constexpr size_t draft_width = open_qwen36::Inkling2Host::verify_limit;
+    static constexpr size_t wide_width = open_qwen36::Inkling2Host::wide_verify_limit;
+    static_assert(lookup_width <= draft_width);
+    size_t capacity_, chunk_;
+    open_qwen36::Inkling2Host model_;
+    std::string draft_path_;
+#ifdef PHLEGM_INKLING2_DSPARK
+    std::unique_ptr<open_qwen36::Inkling2Dspark> draft_;
+    std::vector<float> draft_features_;
+#endif
+#ifdef PHLEGM_INKLING2_VISION
+    std::string mmproj_, kernel_dir_;
+    unsigned timeout_ms_ = 0;
+    std::unique_ptr<open_qwen36::vision::Inkling2Vision> vision_;
+    std::vector<float> image_;
+    size_t image_at_ = 0;
+    static constexpr size_t image_width = open_qwen36::Inkling2Host::embedding_width;
+
+    void encode_image(const json& req) {
+        if (mmproj_.empty()) throw std::runtime_error("vision requires an Inkling 2 vision bundle and mmproj.gguf");
+        if (!image_.empty()) throw std::runtime_error("previous image prefill is incomplete");
+        const int width = req.at("width").get<int>(), height = req.at("height").get<int>();
+        if (width < 40 || width > 4096 || height < 40 || height > 4096)
+            throw std::runtime_error("image sides must be 40–4096 pixels");
+        const size_t rows = static_cast<size_t>((width + 39) / 40) * ((height + 39) / 40);
+        if (rows > capacity_ - model_.position()) throw std::runtime_error("image exceeds context capacity");
+        std::vector<uint8_t> rgb(static_cast<size_t>(width) * height * 3);
+        if (!std::cin.read(reinterpret_cast<char*>(rgb.data()), static_cast<std::streamsize>(rgb.size())))
+            throw std::runtime_error("incomplete RGB input");
+        if (!vision_) {
+            auto backend = open_qwen36::vision::make_inkling2_vision_npu(kernel_dir_, timeout_ms_);
+            if (!backend) throw std::runtime_error("missing Inkling 2 vision backend");
+            vision_ = std::make_unique<open_qwen36::vision::Inkling2Vision>(mmproj_, std::move(backend));
+        }
+        image_ = vision_->encode(rgb, width, height);
+        if (image_.size() != rows * image_width) throw std::runtime_error("image encoder returned unexpected rows");
+        image_at_ = 0;
+        reply({{"image_rows", rows}});
+    }
+
+    void prefill_image(const json& req) {
+        const auto rows = req.at("rows").get<size_t>();
+        const size_t remain = (image_.size() - image_at_) / image_width;
+        if (!rows || rows > chunk_ || rows > remain) throw std::runtime_error("invalid image prefill block");
+        const bool want = req.value("want_logits", false);
+        const size_t end = image_at_ + rows * image_width;
+        std::vector<float> block(image_.begin() + image_at_, image_.begin() + end);
+        const auto logits = model_.append_embeddings(std::move(block), want, {}, capture());
+        append_draft(rows);
+        image_at_ = end;
+        if (image_at_ == image_.size()) {
+            image_.clear();
+            image_at_ = 0;
+        }
+        json ack = {{"position", model_.position()}};
+        if (want) reply_logits(std::move(ack), logits, vocab);
+        else reply(std::move(ack));
+    }
+#endif
+
+    bool can_verify() const { return chunk_ >= lookup_width && model_.block_experts_available(); }
+
+    void reset(bool prepare_draft) {
+        if (prepare_draft && draft_path_.empty()) throw std::runtime_error("DSpark requires dspark.gguf and block verify");
+#ifdef PHLEGM_INKLING2_DSPARK
+        if (!prepare_draft) draft_.reset();
+        else if (draft_) draft_->reset();
+        else draft_ = std::make_unique<open_qwen36::Inkling2Dspark>(draft_path_, model_.weights(), capacity_);
+        draft_features_.clear();
+#endif
+        model_.reset();
+#ifdef PHLEGM_INKLING2_VISION
+        image_.clear();
+        image_at_ = 0;
+#endif
+    }
+
+    std::vector<float>* capture() {
+#ifdef PHLEGM_INKLING2_DSPARK
+        if (draft_) return &draft_features_;
+#endif
+        return nullptr;
+    }
+
+    void append_draft(size_t count) {
+#ifdef PHLEGM_INKLING2_DSPARK
+        if (draft_) {
+            draft_->append(draft_features_, count);
+            draft_features_.clear();
+        }
+#else
+        (void)count;
+#endif
+    }
+
+    std::vector<float> append(const std::vector<int>& ids, bool want_logits) {
+        auto logits = model_.append(ids, want_logits, {}, capture());
+        append_draft(ids.size());
+        return logits;
+    }
+
+    static size_t block_size(const std::string& route, const std::string& mode) {
+        if (mode != "lean" && mode != "fast") throw std::runtime_error("unsupported Inkling 2 prefill mode");
+        if (route == "sequential") return 1;
+        if (route != "auto" && route != "block") throw std::runtime_error("unsupported Inkling 2 prefill route");
+        return mode == "lean" ? 64 : 256;
+    }
+
+    std::vector<float> prefill(const std::vector<int>& ids) {
+        if (ids.empty() || ids.size() > capacity_ - model_.position())
+            throw std::runtime_error("prompt must fit the context capacity");
+        std::vector<float> logits;
+        for (size_t at = 0; at < ids.size();) {
+            const size_t end = std::min(at + chunk_, ids.size());
+            logits = append(std::vector<int>(ids.begin() + at, ids.begin() + end), end == ids.size());
+            at = end;
+        }
+        return logits;
+    }
+
+    static void respond(const std::vector<float>& logits, bool want_logits) {
+        if (want_logits) reply_logits({}, logits, vocab);
+        else reply({{"token", greedy(logits, vocab)}});
+    }
+};
+#endif
 
