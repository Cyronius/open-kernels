+/// Long drafts for a block-route verify pass: chained matches of 4 tokens, never padded.
+/// Shorter matches are common in prose and a rejected long pass costs several decode tokens.
+pub struct LongLookup;
+impl Drafter for LongLookup {
+    fn draft(&mut self, history: &[u32], max: usize) -> Draft {
+        let single = Lookup {
+            nmax: 4,
+            nmin: 4,
+            extend: false,
+        };
+        let mut work = history.to_vec();
+        let mut out = Vec::new();
+        while out.len() < max {
