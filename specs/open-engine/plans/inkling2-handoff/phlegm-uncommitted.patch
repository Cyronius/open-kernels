+/// Pacing for long drafts. A pass has a large fixed cost, so it pays only when most of a long draft is
+/// accepted. After a pass that accepts less than half, plain decode runs for a cooldown that doubles each
+/// time (8 to 256 tokens), which bounds the loss on text that does not repeat.
+pub struct LongPolicy {
+    floor: usize,
+    ceiling: usize,
+    budget: usize,
+    cooldown: usize,
+    penalty: usize,
+}
+impl LongPolicy {
+    pub fn new(min_rows: usize, max_rows: usize) -> Self {
+        let ceiling = max_rows.saturating_sub(1);
+        Self {
+            floor: min_rows.saturating_sub(1).clamp(1, ceiling.max(1)),
+            ceiling,
+            budget: ceiling,
+            cooldown: 0,
+            penalty: 8,
+        }
+    }
+}
+impl DraftPolicy for LongPolicy {
+    fn max_draft(&mut self, remaining: usize, room: usize) -> usize {
+        if self.cooldown > 0 {
+            self.cooldown -= 1;
+            return 0;
+        }
+        let k = self
+            .budget
+            .min(remaining.saturating_sub(1))
+            .min(room.saturating_sub(1));
+        if k < self.floor {
+            0
+        } else {
+            k
+        }
+    }
+    fn min_draft(&self) -> usize {
+        self.floor
+    }
+    fn observe(&mut self, drafted: usize, accepted: usize) {
+        if drafted == 0 {
+            return;
+        }
+        if accepted == drafted {
+            self.budget = (self.budget * 2 + 1).min(self.ceiling);
+            self.penalty = 8;
+        } else if accepted * 2 >= drafted {
+            self.budget = (self.budget / 2).max(self.floor);
+        } else {
+            self.budget = self.floor;
+            self.cooldown = self.penalty;
+            self.penalty = (self.penalty * 2).min(256);
+        }
+    }
