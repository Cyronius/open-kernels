+// A named assistant frame follows the reasoning and text frames. Hold the
+// header while its kind is still unknown, so a tool name never streams as text.
+fn inkling_tool_offset(text: &str) -> Option<usize> {
+    let mut rest = text;
+    loop {
+        let frame = rest.trim_start();
+        if !frame.is_empty() && INKLING_MODEL.starts_with(frame) {
+            return Some(text.len() - frame.len());
+        }
+        let payload = frame.strip_prefix(INKLING_MODEL)?;
+        if let Some(body) = payload
+            .strip_prefix(INKLING_THINK)
+            .or_else(|| payload.strip_prefix(INKLING_TEXT))
+        {
+            rest = body.split_once(INKLING_END)?.1;
+        } else {
+            return Some(text.len() - frame.len());
+        }
+    }
+}
+
+fn inkling(text: &str) -> Option<Parsed> {
+    let start = inkling_tool_offset(text)?;
+    let mut rest = &text[start..];
+    let mut calls = vec![];
+    while let Some(frame) = rest.trim_start().strip_prefix(INKLING_MODEL) {
+        let (recipient, body) = frame.split_once(INKLING_INVOKE)?;
+        // Consume JSON before checking the frame terminator. String arguments
+        // can include the literal spelling of the terminator.
+        let mut values = serde_json::Deserializer::from_str(body).into_iter::<Value>();
+        let data = values.next()?.ok()?;
+        let name = data.get("name")?.as_str()?;
+        if name != recipient {
+            return None;
+        }
+        let args = data.get("args")?.clone();
+        rest = body[values.byte_offset()..]
+            .trim_start()
+            .strip_prefix(INKLING_END)?;
+        calls.push(call(name, args)?);
+    }
+    if calls.is_empty() || !matches!(rest.trim(), "" | INKLING_STOP) {
+        return None;
+    }
+    let mut content = text[..start].to_owned();
+    content.push_str(rest);
+    Some(Parsed { content, calls })
+}
