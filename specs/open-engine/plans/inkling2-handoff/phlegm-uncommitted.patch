+use crate::backend::PromptImage;
+use serde_json::{json, Value};
+
+pub(super) fn has_images(messages: &[Value]) -> bool {
+    messages.iter().filter_map(|m| m["content"].as_array()).flatten().any(is_image)
+}
+
+fn is_image(part: &Value) -> bool {
+    part["type"] == "image_url"
+}
+
+pub(super) fn parse(messages: &[Value], leading: usize) -> Result<(Vec<Option<Value>>, Vec<PromptImage>), String> {
+    let mut contents = vec![None; leading];
+    let mut images = Vec::new();
+    for message in messages {
+        let Some(parts) = message["content"].as_array().filter(|parts| parts.iter().any(is_image)) else {
+            contents.push(None);
+            continue;
+        };
+        if message["role"].as_str().unwrap_or("user") != "user" {
+            return Err("images are allowed in user messages".into());
+        }
+        let mut content = Vec::new();
+        for part in parts {
+            match part["type"].as_str() {
+                Some("text") => {
+                    let value = part["text"].as_str().ok_or("text content must be a string")?;
+                    content.push(json!({"type":"text", "text":value}));
+                }
+                Some("image_url") => {
+                    let url = part["image_url"]["url"].as_str().ok_or("image_url.url must be a string")?;
+                    images.push(decode_png(url)?);
+                    content.push(json!({"type":"image"}));
+                }
+                _ => return Err("image message content must contain text or image_url parts".into()),
+            }
+        }
+        contents.push(Some(Value::Array(content)));
+    }
+    Ok((contents, images))
+}
+
+fn decode_png(url: &str) -> Result<PromptImage, String> {
+    let data = url.strip_prefix("data:image/png;base64,").ok_or("image_url requires an inline PNG data URL")?;
+    let bytes = base64::decode(data).map_err(|_| "image is not valid base64")?;
+    let mut decoder = png::Decoder::new(std::io::Cursor::new(bytes));
+    decoder.set_transformations(png::Transformations::normalize_to_color8());
+    decoder.set_limits(png::Limits { bytes: 128 * 1024 * 1024 });
+    let info = decoder.read_header_info().map_err(|e| format!("invalid PNG: {e}"))?;
+    let (width, height) = (info.width as usize, info.height as usize);
+    if !(40..=4096).contains(&width) || !(40..=4096).contains(&height) {
+        return Err("image sides must be 40–4096 pixels".into());
+    }
+    let mut reader = decoder.read_info().map_err(|e| format!("invalid PNG: {e}"))?;
+    if reader.info().animation_control.is_some() { return Err("image input requires a still PNG".into()); }
+    let mut decoded = vec![0; reader.output_buffer_size()];
+    let frame = reader.next_frame(&mut decoded).map_err(|e| format!("invalid PNG: {e}"))?;
+    decoded.truncate(frame.buffer_size());
+    let rgb = match frame.color_type {
+        png::ColorType::Rgb => decoded,
+        png::ColorType::Rgba => decoded.chunks_exact(4).flat_map(|p| [p[0], p[1], p[2]]).collect(),
+        png::ColorType::Grayscale => decoded.into_iter().flat_map(|p| [p; 3]).collect(),
+        png::ColorType::GrayscaleAlpha => decoded.chunks_exact(2).flat_map(|p| [p[0]; 3]).collect(),
+        png::ColorType::Indexed => return Err("PNG palette was not expanded".into()),
+    };
+    if rgb.len() != 3 * width * height { return Err("PNG dimensions changed during decode".into()); }
+    Ok(PromptImage { position: 0, width, height, rgb })
+}
+
+pub(super) fn expand(prompt: &[u32], placeholder: u32, images: &mut [PromptImage]) -> Result<Vec<u32>, String> {
+    let mut pending = images.iter_mut();
+    let mut result = Vec::new();
+    for &id in prompt {
+        if id == placeholder {
+            let image = pending.next().ok_or("chat template emitted an unexpected image placeholder")?;
+            image.position = result.len();
+            result.resize(result.len() + image.rows(), placeholder);
+        } else {
+            result.push(id);
+        }
+    }
+    if pending.next().is_some() { return Err("chat template omitted an image placeholder".into()); }
+    Ok(result)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn expands_image_parts_in_order_and_preserves_text() {
+        let mut png = Vec::new();
+        let pixel = [100, 150, 200, 255];
+        {
+            let mut encoder = png::Encoder::new(&mut png, 41, 40);
+            encoder.set_color(png::ColorType::Rgba);
+            encoder.write_header().unwrap().write_image_data(&pixel.repeat(41 * 40)).unwrap();
+        }
+        let part = json!({"type":"image_url", "image_url":{"url":format!("data:image/png;base64,{}", base64::encode(png))}});
+        let messages = [json!({"role":"user", "content":[{"type":"text", "text":"before"}, part.clone(),
+                         {"type":"text", "text":"between"}, part]})];
+        let (content, mut images) = parse(&messages, 1).unwrap();
+        assert!(content[0].is_none());
+        assert_eq!(content[1].as_ref().unwrap()[2]["text"], "between");
+        assert_eq!(images[0].rgb[..3], pixel[..3]);
+        assert_eq!(expand(&[10, 99, 11, 99, 12], 99, &mut images).unwrap(), [10, 99, 99, 11, 99, 99, 12]);
+        assert_eq!((images[0].position, images[1].position), (1, 4));
+        assert!(expand(&[10, 99, 11], 99, &mut images).is_err());
+    }
+}
